<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  班级学生成绩管理系统 - 部署描述符
  Servlet 规范版本：3.1（对应 Tomcat 8.5）
  说明：本项目不使用 @WebServlet 注解，全部在这里集中配置，
        便于老师一眼看清"有哪些组件、映射到什么地址"。
  ============================================================
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>score-management</display-name>
    <description>班级学生成绩管理系统（原生 JavaEE MVC）</description>

    <!-- ==========================================================
         一、过滤器
         注意顺序：encodingFilter 必须在前面（先解决乱码，再做权限判断）
         ========================================================== -->

    <!-- 1. 统一编码过滤器：解决请求和响应的中文乱码 -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>com.score.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 2. 登录与角色权限过滤器：拦截未登录访问和跨角色越权 -->
    <filter>
        <filter-name>authFilter</filter-name>
        <filter-class>com.score.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ==========================================================
         二、Servlet
         ========================================================== -->

    <!-- 登录：POST /login -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.score.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- 退出登录：GET /logout -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.score.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- 教师端成绩管理：/teacher/score?action=list|edit|save|delete -->
    <servlet>
        <servlet-name>TeacherScoreServlet</servlet-name>
        <servlet-class>com.score.servlet.TeacherScoreServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherScoreServlet</servlet-name>
        <url-pattern>/teacher/score</url-pattern>
    </servlet-mapping>

    <!-- 学生端成绩查询：/student/score -->
    <servlet>
        <servlet-name>StudentScoreServlet</servlet-name>
        <servlet-class>com.score.servlet.StudentScoreServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentScoreServlet</servlet-name>
        <url-pattern>/student/score</url-pattern>
    </servlet-mapping>

    <!-- ==========================================================
         三、Session 与欢迎页
         ========================================================== -->

    <!-- 会话 30 分钟无操作自动失效。注意：单位为【分钟】 -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- 访问 http://localhost:8080/score-management/ 时默认打开登录页 -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- ==========================================================
         四、统一错误页
         页面里只显示友好提示，堆栈信息写进 Tomcat 日志，绝不暴露给用户
         ========================================================== -->

    <!-- 404：地址写错或资源不存在 -->
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>

    <!-- 500：服务器内部错误（如数据库连不上） -->
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>

    <!-- 任何未捕获的异常也导向错误页，作为最后一道保险 -->
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error.jsp</location>
    </error-page>

</web-app>
