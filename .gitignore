# ============================================================
#  Git 忽略规则
#  目的：只把源码、SQL、配置模板、文档提交到仓库，
#        编译产物和 IDEA 个人配置一律不提交
# ============================================================

# ---- Maven 构建产物 ----
target/
!.mvn/wrapper/maven-wrapper.jar

# ---- IDEA 项目文件 ----
.idea/
*.iml
*.ipr
*.iws
out/

# ---- Eclipse / VS Code（防止同学换编辑器后误提交） ----
.settings/
.classpath
.project
.vscode/

# ---- 编译输出 ----
*.class
*.jar
*.war
*.ear

# ---- 本地运行 Tomcat 实例（本项目自测用，不含任何源码） ----
.tomcat-base/

# ---- 日志与临时文件 ----
*.log
logs/
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db

# ---- 注意：src/main/resources/db.properties 里含有数据库密码 ----
# 课程作业为了方便演示，保留提交；
# 如果是真实项目，应改为提交 db.properties.example，把真实密码排除在外。
